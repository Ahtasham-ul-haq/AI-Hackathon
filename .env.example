# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by the hourly run and generation to write papers.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# News (server-only)
GNEWS_API_KEY=

# Shared secret the GitHub Action sends to /api/cron/morning
CRON_SECRET=

# Only this signed-in email can use the "generate next edition now" demo trigger
BUILDER_EMAIL=

# Public base URL of the deployment (used for auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
